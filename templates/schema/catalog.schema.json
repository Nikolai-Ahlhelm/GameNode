{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamenode.dev/schemas/catalog-v1.json",
  "title": "GameNode Official Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "templates"],
  "properties": {
    "schema_version": {"const": 1},
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "category", "version", "template_schema_version", "platforms", "installer", "file", "tags"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
          "category": {"type": "string"}, "version": {"type": "string"}, "template_schema_version": {"enum": [1, 2]},
          "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["windows", "linux"]}},
          "installer": {"enum": ["steamcmd", "existing", "existing-files"]}, "file": {"type": "string", "pattern": "^[^:/\\\\]+(?:/[^:/\\\\]+)*\\.json$"},
          "tags": {"type": "array", "items": {"type": "string"}}, "icon": {"type": "string"}, "minimum_gamenode_version": {"type": "string"}
        }
      }
    }
  }
}
