{
  "schema_version": 2,
  "id": "minecraft-java",
  "name": "Minecraft Java Edition",
  "description": "Install a Minecraft Java Edition server - vanilla, NeoForge, Forge, or Fabric - at an exact Minecraft and loader version, then manage its mods.",
  "version": "1.1.0",
  "category": "minecraft",
  "minimum_gamenode_version": "1.2.0",
  "known_limitations": [
    "Java must be installed through JAVA_HOME or PATH and match the Minecraft version (Java 21 for 1.20.5-1.21.x, Java 25 for 26.x).",
    "Forge is offered for Minecraft 1.17 and newer; NeoForge for 1.20.2 and newer.",
    "Forge, NeoForge and Fabric download their own libraries during installation or first start.",
    "The Minecraft EULA is accepted only if the operator ticks the EULA option when creating the server.",
    "Some server.properties keys exist only in newer Minecraft versions; GameNode writes all managed keys and Minecraft ignores unknown ones."
  ],
  "icon": "minecraft",
  "source_type": "official",
  "source_identifier": "minecraft-java",
  "source_format_version": "2",
  "tags": [
    "minecraft",
    "java",
    "mods",
    "vanilla",
    "neoforge",
    "forge",
    "fabric"
  ],
  "source_metadata": {
    "author": "GameNode",
    "tags": [
      "minecraft",
      "java",
      "mods",
      "vanilla",
      "neoforge",
      "forge",
      "fabric"
    ]
  },
  "installer": {
    "type": "minecraft"
  },
  "launch": {
    "executable": "java",
    "arguments": [],
    "working_root": "server_root",
    "stop_command": "stop",
    "stop_method": "stdin_command",
    "stop_timeout_seconds": 60,
    "resolver": "minecraft"
  },
