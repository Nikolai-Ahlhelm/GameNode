      "section": "World",
      "type": "integer",
      "property": "view-distance",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {
        "min": 3,
        "max": 32
      }
    },
    {
      "key": "MC_SIMULATION_DISTANCE",
      "label": "Simulation distance",
      "description": "Chunks around players that are ticked.",
      "section": "World",
      "type": "integer",
      "property": "simulation-distance",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {
        "min": 3,
        "max": 32
      }
    },
    {
      "key": "MC_MAX_WORLD_SIZE",
      "label": "Maximum world size",
      "description": "Maximum world radius in blocks.",
      "section": "World",
      "type": "integer",
      "property": "max-world-size",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {
        "min": 1,
        "max": 29999984
      }
    },
    {
      "key": "MC_ENTITY_BROADCAST_RANGE",
