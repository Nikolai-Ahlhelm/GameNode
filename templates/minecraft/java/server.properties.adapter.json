      "section": "World",
      "type": "boolean",
      "property": "allow-nether",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {}
    },
    {
      "key": "MC_VIEW_DISTANCE",
      "label": "View distance",
