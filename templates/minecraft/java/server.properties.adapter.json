      "section": "Advanced",
      "type": "integer",
      "property": "rate-limit",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {
        "min": 0,
        "max": 2147483647
      }
    },
    {
      "key": "MC_MAX_CHAINED_UPDATES",
      "label": "Max chained neighbor updates",
      "description": "Limit on consecutive neighbor updates before skipping.",
      "section": "Advanced",
      "type": "integer",
      "property": "max-chained-neighbor-updates",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {
        "min": -1,
        "max": 2147483647
      }
    },
    {
      "key": "MC_USE_NATIVE_TRANSPORT",
      "label": "Native transport",
      "description": "Use optimized Linux packet handling.",
      "section": "Advanced",
      "type": "boolean",
      "property": "use-native-transport",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {}
