      "section": "Advanced",
      "type": "integer",
      "property": "max-tick-time",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {
        "min": -1,
        "max": 9223372036854775807
      }
    },
    {
      "key": "MC_NETWORK_COMPRESSION",
      "label": "Network compression threshold",
      "description": "Compress packets larger than this many bytes. -1 disables.",
      "section": "Advanced",
      "type": "integer",
      "property": "network-compression-threshold",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {
        "min": -1,
        "max": 2147483647
      }
    },
    {
      "key": "MC_RATE_LIMIT",
