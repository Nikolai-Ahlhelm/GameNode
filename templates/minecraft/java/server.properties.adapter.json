      "type": "integer",
      "property": "entity-broadcast-range-percentage",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {
        "min": 10,
        "max": 1000
      }
    },
    {
      "key": "MC_SYNC_CHUNK_WRITES",
      "label": "Synchronous chunk writes",
      "description": "Write region files synchronously to avoid corruption on crashes.",
      "section": "Advanced",
      "type": "boolean",
      "property": "sync-chunk-writes",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {}
    },
    {
      "key": "MC_REGION_FILE_COMPRESSION",
      "label": "Region file compression",
      "description": "Compression for region files.",
      "section": "Advanced",
      "type": "enum",
      "property": "region-file-compression",
      "required": true,
      "nullable": false,
      "sensitive": false,
      "validation": {
