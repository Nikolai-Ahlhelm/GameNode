  "platform_launches": {"linux": {"executable": "Battalion/Binaries/Linux/BattalionServer-Linux-Shipping", "arguments": ["Battalion", "-QueryPort={{QUERY_PORT}}", "-SteamServerName={{SERVER_NAME}}", "-Queue=Wartide", "-Log"], "working_root": "server_root", "stop_method": "terminate", "stop_timeout_seconds": 60}},
  "variables": [
    {"name": "Query port", "key": "QUERY_PORT", "default_value": "27016", "user_viewable": true, "user_editable": true, "type": "integer", "sensitive": false, "required": true, "nullable": false, "validation": {"min": 1024, "max": 65535}, "group": "Network"},
    {"name": "Server name", "key": "SERVER_NAME", "default_value": "GameNode Battalion Server", "user_viewable": true, "user_editable": true, "type": "string", "sensitive": false, "required": true, "nullable": false, "validation": {"min_length": 1, "max_length": 80}, "group": "Server"}
  ],
  "ports": [{"name": "Game", "protocol": "udp", "port": 7777, "required": true}, {"name": "Query", "protocol": "udp", "variable": "QUERY_PORT", "required": true}],
  "expected_files": [{"path": "Battalion/Binaries/Linux/BattalionServer-Linux-Shipping", "type": "file", "required": true, "executable": true, "platform": "linux"}],
  "requirements": [{"type": "os", "level": "hard", "value": "linux", "description": "The reviewed Pelican launch targets Linux."}, {"type": "steamcmd", "level": "hard", "value": "anonymous", "description": "Managed anonymous SteamCMD is required."}],
  "help": {"summary": "GameNode installs Steam App 805140 anonymously and starts the native Linux server."},
  "compatibility": {"status": "compatible", "findings": [{"severity": "info", "component": "configuration", "code": "BATTALION_FILE_CONFIGURATION", "summary": "Advanced settings remain file-managed."}]},
