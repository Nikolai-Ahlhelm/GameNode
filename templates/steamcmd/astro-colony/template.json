    {"name": "Server name", "key": "SERVER_NAME", "default_value": "GameNode Astro Colony Server", "user_viewable": true, "user_editable": true, "type": "string", "sensitive": false, "required": true, "nullable": false, "validation": {"min_length": 1, "max_length": 80}, "group": "Server"}
  ],
  "ports": [{"name": "Game", "protocol": "udp", "port": 7777, "required": true}, {"name": "Query", "protocol": "udp", "variable": "QUERY_PORT", "required": true}],
  "expected_files": [{"path": "AstroColony/Binaries/Linux/AstroColonyServer", "type": "file", "required": true, "executable": true, "platform": "linux"}],
  "requirements": [{"type": "os", "level": "hard", "value": "linux", "description": "The reviewed Pelican launch targets Linux."}, {"type": "steamcmd", "level": "hard", "value": "anonymous", "description": "Managed anonymous SteamCMD is required."}],
