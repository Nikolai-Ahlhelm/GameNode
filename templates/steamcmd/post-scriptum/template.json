{
  "schema_version": 2, "id": "post-scriptum", "name": "Post Scriptum Dedicated Server",
  "description": "Install the Post Scriptum dedicated server through SteamCMD and launch its native Linux server directly.",
  "version": "1.0.0", "category": "steamcmd", "minimum_gamenode_version": "0.2.0",
  "known_limitations": ["The upstream Egg exposes additional file-backed server settings that are not imported.", "Stop uses the bounded terminate fallback."],
  "icon": "steamcmd", "source_type": "official", "source_identifier": "pelican-eggs/post_scriptum", "source_format_version": "2",
  "tags": ["post-scriptum", "steam", "steamcmd", "fps", "military"],
  "source_metadata": {"author": "GameNode, normalized from Pelican Eggs", "tags": ["post-scriptum", "steam", "steamcmd", "fps", "military"]},
  "installer": {"type": "steamcmd", "steamcmd": {"app_id": 746200, "validate": true, "login_mode": "anonymous", "platform": "native", "install_target": "server_root"}},
  "platform_launches": {"linux": {"executable": "PostScriptum/Binaries/Linux/PostScriptumServer", "arguments": ["Port={{SERVER_PORT}}", "QueryPort={{QUERY_PORT}}", "-fullcrashdump", "-log"], "working_root": "server_root", "stop_method": "terminate", "stop_timeout_seconds": 60}},
  "variables": [
    {"name": "Game port", "key": "SERVER_PORT", "default_value": "10027", "user_viewable": true, "user_editable": true, "type": "integer", "sensitive": false, "required": true, "nullable": false, "validation": {"min": 1024, "max": 65535}, "group": "Network"},
    {"name": "Query port", "key": "QUERY_PORT", "default_value": "10037", "user_viewable": true, "user_editable": true, "type": "integer", "sensitive": false, "required": true, "nullable": false, "validation": {"min": 1024, "max": 65535}, "group": "Network"}
  ],
  "ports": [{"name": "Game", "protocol": "udp", "variable": "SERVER_PORT", "required": true}, {"name": "Query", "protocol": "udp", "variable": "QUERY_PORT", "required": true}],
  "expected_files": [{"path": "PostScriptum/Binaries/Linux/PostScriptumServer", "type": "file", "required": true, "executable": true, "platform": "linux"}],
  "requirements": [{"type": "os", "level": "hard", "value": "linux", "description": "The reviewed Pelican launch targets Linux."}, {"type": "steamcmd", "level": "hard", "value": "anonymous", "description": "Managed anonymous SteamCMD is required."}],
  "help": {"summary": "GameNode installs Steam App 746200 anonymously and starts PostScriptumServer directly."},
  "compatibility": {"status": "partially_compatible", "findings": [{"severity": "warning", "component": "configuration", "code": "POST_SCRIPTUM_FILE_CONFIGURATION", "summary": "File-backed settings from the Egg are not imported."}]},
  "read_only": true, "platforms": ["linux"], "prerequisites": ["64-bit Linux host", "Network access to Steam content servers"]
}
