{
  "schema_version": 2, "id": "colony-survival", "name": "Colony Survival Dedicated Server",
  "description": "Install the Colony Survival dedicated server through SteamCMD and launch its native Linux server directly.",
  "version": "1.0.0", "category": "steamcmd", "minimum_gamenode_version": "0.2.0",
  "known_limitations": ["Advanced world configuration remains file-managed.", "Stop uses the bounded terminate fallback."],
