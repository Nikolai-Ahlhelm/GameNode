{
  "schema_version": 2,
  "id": "project-zomboid",
  "name": "Project Zomboid",
  "description": "Install the official dedicated server through SteamCMD and run its bundled Java runtime without scripts.",
  "version": "2.0.0",
  "category": "steamcmd",
  "minimum_gamenode_version": "0.2.0",
  "known_limitations": [
    "The current Windows Steam build is supported and verified; Linux remains hidden until its direct native launch has been acceptance-tested.",
    "The first start creates Project Zomboid configuration and world data below the isolated server root.",
    "SteamCMD supports initial installation and explicit manual updates through GameNode's Update Server action; automatic, scheduled, and update-on-start updates are not enabled."
  ],
  "icon": "steamcmd",
  "source_type": "official",
  "source_identifier": "project-zomboid",
  "source_format_version": "2",
  "tags": ["project-zomboid", "steam", "steamcmd", "survival", "zombies", "java"],
  "source_metadata": {
    "author": "GameNode",
    "tags": ["project-zomboid", "steam", "steamcmd", "survival", "zombies", "java"]
  },
  "installer": {
    "type": "steamcmd",
    "steamcmd": {
      "app_id": 380870,
      "validate": true,
      "login_mode": "anonymous",
      "platform": "native",
      "install_target": "server_root"
    }
  },
  "platform_launches": {
    "windows": {
      "executable": "jre64/bin/java.exe",
      "arguments": [
        "-Djava.awt.headless=true",
        "-Xmx3072m",
        "-Dzomboid.steam=1",
        "-Dzomboid.znetlog=1",
        "-Djava.library.path=natives/",
        "-XX:-CreateCoredumpOnCrash",
        "-XX:-OmitStackTraceInFastThrow",
        "-XX:+UseZGC",
        "-cp",
        "java/.;java/projectzomboid.jar",
        "zombie.network.GameServer",
        "-statistic",
        "0",
        "-cachedir=.",
        "-servername",
        "gamenode",
        "-port",
        "{{SERVER_PORT}}"
      ],
      "working_root": "server_root",
      "stop_method": "stdin_command",
      "stop_command": "quit",
      "stop_timeout_seconds": 60
    }
  },
  "variables": [
    {
      "name": "Server port",
      "description": "Primary Project Zomboid game port.",
      "key": "SERVER_PORT",
      "default_value": "16261",
      "user_viewable": true,
      "user_editable": true,
      "type": "integer",
      "sensitive": false,
      "required": true,
      "nullable": false,
      "validation": {"min": 1024, "max": 65534},
      "group": "Network"
    }
  ],
  "ports": [
    {"name": "Game UDP", "protocol": "udp", "variable": "SERVER_PORT", "required": true, "purpose": "Primary game traffic"},
    {"name": "Direct connection UDP", "protocol": "udp", "variable": "SERVER_PORT", "offset": 1, "required": true, "purpose": "Direct client connections"}
  ],
  "expected_files": [
    {"path":"jre64/bin/java.exe","type":"file","required":true,"executable":true,"platform":"windows"},
    {"path":"java/projectzomboid.jar","type":"file","required":true,"platform":"windows"},
    {"path":"natives","type":"directory","required":true,"platform":"windows"}
  ],
  "config_files": [{"path":"Server/gamenode.ini","format":"ini","description":"Generated on first start and then exposed through the reviewed INI adapter."}],
  "requirements": [
    {"type":"os","level":"hard","value":"windows","description":"The reviewed direct launch is currently Windows-only."},
    {"type":"architecture","level":"hard","value":"amd64","description":"The reviewed bundled runtime is 64-bit."},
    {"type":"steamcmd","level":"hard","value":"anonymous","description":"Managed SteamCMD with anonymous login is required for installation."}
  ],
  "help": {"summary":"GameNode bypasses StartServer64.bat and starts the bundled Java runtime with a reviewed argv list.","notes":["Linux remains unavailable until its direct invocation is acceptance-tested."]},
  "configuration": {
    "adapters": [
      {"id": "project-zomboid-server-ini", "schema_version": 1, "file": "server.ini.adapter.json"}
    ]
  },
  "compatibility": {"status": "compatible", "findings": []},
  "read_only": true,
  "platforms": ["windows"],
  "prerequisites": [
    "Network access to Steam content servers",
    "At least 8 GB free storage for the current dedicated server build",
    "At least 4 GB available memory"
  ]
}
